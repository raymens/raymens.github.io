---
layout: base.njk
---
<section class="page-section post-header">
  <div class="container">
    <h1 class="post-title">{{ title }}</h1>
    <p class="post-meta">
      {% if author %}{{ author }} · {% endif %}{{ date | readableDate }}
    </p>
  </div>
</section>
<section class="page-section">
  <div class="container post-body">
    {{ content | safe }}
  </div>
</section>
